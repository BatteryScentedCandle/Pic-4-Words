<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#225522" /> <!-- deep green shadow -->
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Border -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#7FFF7F" />
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#03AC13" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</layer-list>
