<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/trophyAnimation"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toTopOf="@id/scoreContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/trophy" />

    <LinearLayout
        android:id="@+id/scoreContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="20dp" >

        <TextView
            android:id="@+id/scoreNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/imageButtonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
             >


            <ImageButton
                android:id="@+id/returnToCategoryBtn"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginRight="10dp"
                android:contentDescription="Button to return to category"
                android:src="@drawable/icon_return"
                android:layout_gravity="center" />


            <ImageButton
                android:id="@+id/returnToMainMenuBtn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:contentDescription="Button to return to main menu"
                android:src="@drawable/icon_home"
                android:layout_gravity="center" />


            <ImageButton
                android:id="@+id/shareBtn"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginLeft="10dp"
                android:contentDescription="Button to share"
                android:src="@android:drawable/ic_menu_share"
                android:layout_gravity="center" />

        </LinearLayout>



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>