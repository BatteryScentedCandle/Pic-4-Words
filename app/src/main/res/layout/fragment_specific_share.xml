<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000"
    >

    <RelativeLayout
        android:id="@+id/sharePanel"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="#192B59"
        android:padding="20dp"
        android:elevation="8dp">


        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="1dp"
            android:background="@drawable/close_button_bg"
            android:contentDescription="@string/close_settings"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

        <TextView
            android:id="@+id/tvFragLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:text="Score"
            android:textSize="23sp"
            android:textColor="@color/white"/>


        <TextView
            android:id="@+id/tvCategoryDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/tvFragLabel"
            android:layout_marginTop="100dp"
            android:hint="something"
            android:text=""
            android:textSize="28sp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"/>

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/tvCategoryDifficulty"
            android:layout_marginTop="10dp"
            android:hint="score"
            android:text=""
            android:textSize="25sp"
            android:textColor="@color/white"
            android:textColorHint="@color/white"/>

        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/tvScore"
            android:layout_marginTop="20dp">

            <ImageButton
                android:id="@+id/returnToCategoryBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:contentDescription="Button to return to category"
                android:src="@drawable/icon_return"
                android:layout_gravity="center" />


            <ImageButton
                android:id="@+id/returnToMainMenuBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:contentDescription="Button to return to main menu"
                android:src="@drawable/icon_home"
                android:layout_gravity="center" />
        </LinearLayout>


    </RelativeLayout>
</FrameLayout>